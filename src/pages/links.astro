---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import links from '../data/links.json';
---

<BaseLayout title="相關連結" description="運動、教育與學術相關網站連結。">
  <div class="content-shell reading-shell">
    <PageHeader title="相關連結" />
    <ul class="simple-list link-list">
      {links.map((link) => (
        <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
