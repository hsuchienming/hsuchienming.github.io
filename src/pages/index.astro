---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import news from '../data/news.json';
import selfPhoto from '../assets/self.jpg';

const recentNews = news.filter((item) => !item.archived).slice(0, 3);
---

<BaseLayout title="首頁">
  <section class="hero" aria-labelledby="home-title">
    <figure class="hero-media">
      <Image src={selfPhoto} alt="許建民教授於東京巨蛋前留影" widths={[640, 960, 1280]} sizes="(max-width: 820px) calc(100vw - 2rem), 62vw" format="webp" loading="eager" fetchpriority="high" />
    </figure>
    <div class="hero-copy">
      <h1 id="home-title">許建民</h1>
      <p class="hero-role">國立清華大學 運動科學系</p>
      <p class="hero-focus">運動行銷、休閒行為、手球</p>
      <a class="text-link" href="/study.html">查看學術發表 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-news" aria-labelledby="news-title">
    <div class="section-heading">
      <h2 id="news-title">最新消息</h2>
      <a href="/passphrase.html">查看全部</a>
    </div>
    <ul class="news-list">
      {recentNews.map((item) => (
        <li class="news-item">
          <span class="news-kind">{item.kind}</span>
          <p>{item.title}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
